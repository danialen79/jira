# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Provider selection
# - gemini: uses Google's Gemini via GEMINI_API_KEY
# - avalai: uses OpenAI-compatible API at https://api.avalai.ir/v1 via AVALAI_API_KEY
# - arvan: uses OpenAI-compatible Arvan AIaaS Gateway via ARVAN_API_KEY + ARVAN_BASE_URL
AI_PROVIDER="gemini"

# AVALAI_API_KEY: Required when AI_PROVIDER="avalai"
AVALAI_API_KEY="MY_AVALAI_API_KEY"

# Optional default AvalAI model (used if you don't pass `model` from UI)
AVALAI_DEFAULT_MODEL="gpt-4o-mini"

# Arvan AIaaS (OpenAI-compatible). Create an Endpoint in the Arvan panel and paste:
# - API Key
# - Gateway / Base URL (usually ends with /v1)
ARVAN_API_KEY="MY_ARVAN_API_KEY"
ARVAN_BASE_URL="https://YOUR_ARVAN_GATEWAY_URL/v1"
# Must match the model segment in your gateway URL (e.g. Gemini-3-Flash-Preview)
ARVAN_DEFAULT_MODEL="Gemini-3-Flash-Preview"

# APP_URL: The URL where this app is hosted (optional).
APP_URL="http://localhost:3000"

# Mattermost Integration Configuration
MATTERMOST_URL="https://your-mattermost-url.com"
MATTERMOST_BOT_TOKEN="your-bot-token"

# -----------------------------------------------------------------------------
# Jira Server / Data Center (single-tenant, server-side only — never sent to browser)
# -----------------------------------------------------------------------------
JIRA_URL="https://jira.yourcompany.com"
# Auth: "pat" (Bearer Personal Access Token) or "basic" (username + password/API token)
JIRA_AUTH_TYPE="pat"
JIRA_TOKEN="your-jira-personal-access-token"
# For basic auth instead of PAT:
# JIRA_AUTH_TYPE="basic"
# JIRA_USERNAME="your-username"
# JIRA_PASSWORD="your-password-or-api-token"

# Default project for all Jira operations
JIRA_PROJECT="PROJ"

# Optional custom field IDs for Jira Server/DC epics & sprints
# JIRA_EPIC_NAME_FIELD="customfield_10008"
# JIRA_EPIC_LINK_FIELD="customfield_10014"
# JIRA_SPRINT_FIELD="customfield_10010"
